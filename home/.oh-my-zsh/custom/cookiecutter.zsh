# ── Cookiecutter shortcuts ──────────────────────────────────────────

# Note: caching
# Pass `--overwrite-if-exist` to alias to force redownload
# e.g., cc-py --overwrite-if-exist

# Standard Python package (PyPI-ready structure)
alias cc-py="cookiecutter gh:audreyfeldroy/cookiecutter-pypackage"

# Data science / ML project layout
alias cc-ds="cookiecutter gh:drivendata/cookiecutter-data-science"

# FastAPI backend project
alias cc-api="cookiecutter gh:arthurhenrique/cookiecutter-fastapi"

# Meta: scaffold a new cookiecutter template (for when you're ready)
alias cc-template="cookiecutter gh:audreyfeldroy/cookiecutter-cookiecutter"
